{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.10",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.10",
    "@repo/db": "workspace:*",
    "bcrypt": "6.0.0",
    "drizzle-orm": "0.45.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-fsrs": "5.2.3",
    "uuidv7": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.10",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "11.11.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.3",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "eslint": "10.15.0",
    "jest": "30.2.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "testcontainers": "11.11.0",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/db-test-setup.ts",
    "globalTeardown": "<rootDir>/test/db-test-teardown.ts",
    "setupFilesAfterEnv": [
      "<rootDir>/test/close-db-after-each-file.ts"
    ]
  }
}
