# Neon connection string (pooled) for this environment
DATABASE_URL=postgres://user:password@host/db
# Signs login tokens (at least 32 characters): openssl rand -hex 32
JWT_SECRET=
# The web app's origin
CORS_ORIGIN=http://localhost:3000
# Shared with the web app (at least 32 characters): openssl rand -hex 32
WEB_API_SECRET=
PORT=4000
